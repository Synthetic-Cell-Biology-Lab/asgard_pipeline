        """


# ---- NEW: master-table accumulation (feature 2) ----------------------------

rule update_master_checkm2:
    """
    Appends this run's CheckM2 quality reports (across all orgs) into a
    single running master table, keyed by genome `Name`. Existing rows for
    a genome are refreshed if it was reprocessed; genomes new to this run
    are simply appended - so the master table always reflects every genome
    ever assessed, not just this run's set.
    """
    input:
        reports = expand(f"{RUN_DIR}/checkm2/{{org}}/quality_report.tsv", org=ORGS)
    output:
        master = f"{MASTER_DIR}/checkm2_quality_report.tsv"
    run:
        import pandas as pd
        import os

        new_df = pd.concat(
            [pd.read_csv(f, sep="\t") for f in input.reports],
            ignore_index=True
        )

        os.makedirs(MASTER_DIR, exist_ok=True)

        if UPDATE_MODE and os.path.exists(output.master):
            old_df = pd.read_csv(output.master, sep="\t")
            combined = pd.concat([old_df, new_df], ignore_index=True)
        else:
            combined = new_df

        combined = combined.drop_duplicates(subset="Name", keep="last")
        combined.to_csv(output.master, sep="\t", index=False)


rule update_master_gtdbtk:
    """
    Same idea as update_master_checkm2, but for GTDB-Tk taxonomic
    classifications, keyed by `user_genome`.
    """
    input:
        taxonomy = expand(
            f"{RUN_DIR}/gtdbtk/{{org}}_gtdbtk_classification_split.ar53.csv",
            org=ORGS
        )
    output:
        master = f"{MASTER_DIR}/gtdbtk_classification.ar53.csv"
    run:
        import pandas as pd
        import os

        new_df = pd.concat(
            [pd.read_csv(f) for f in input.taxonomy],
            ignore_index=True
        )

        os.makedirs(MASTER_DIR, exist_ok=True)

        if UPDATE_MODE and os.path.exists(output.master):
            old_df = pd.read_csv(output.master)
            combined = pd.concat([old_df, new_df], ignore_index=True)
        else:
            combined = new_df

        combined = combined.drop_duplicates(subset="user_genome", keep="last")
        combined.to_csv(output.master, index=False)


# helper functions to get the bakta, interproscan and collation output for all genomes
def _get_filtered_genome_list(org):
    csv_path = checkpoints.split_taxonomy.get(org=org).output[0]
    df = pd.read_csv(csv_path)
    phyla = config['interproscan']['phylum_filter']
    if isinstance(phyla, str):
        phyla = [phyla]
    return df[df['phylum'].isin(phyla)]['user_genome'].tolist()


def filtered_genomes_for_org(wildcards):
    genomes = _get_filtered_genome_list(wildcards.org)
    return expand(f"{BAKTA_OUTDIR}/{{org}}/{{genome}}/{{genome}}_domains.tsv",
                  org=wildcards.org, genome=genomes)

def filtered_faa_for_org(wildcards):
    genomes = _get_filtered_genome_list(wildcards.org)
    return expand(f"{BAKTA_OUTDIR}/{{org}}/{{genome}}/{{genome}}.faa",
                  org=wildcards.org, genome=genomes)

def filtered_tsv_for_org(wildcards):
    genomes = _get_filtered_genome_list(wildcards.org)
    return expand(f"{BAKTA_OUTDIR}/{{org}}/{{genome}}/{{genome}}.tsv",
                  org=wildcards.org, genome=genomes)


def get_interpro_files(wildcards):
    return expand(
        f"{BAKTA_OUTDIR}/{{org}}/{{genome}}/{{genome}}_domains.tsv",
        org=wildcards.org,
        genome=_get_filtered_genome_list(wildcards)
    )


# 
rule bakta:
    input:
        flag   = f"{RUN_DIR}/gtdbtk/{{org}}/gtdbtk_done.flag",
        genome =  f"{RUN_DIR}/skder/{{org}}/Dereplicated_Representative_Genomes/{{genome}}.fna"
    output:
        fasta = f"{BAKTA_OUTDIR}/{{org}}/{{genome}}/{{genome}}.faa",
        tsv = f"{BAKTA_OUTDIR}/{{org}}/{{genome}}/{{genome}}.tsv"
    params:
        outdir = f"{BAKTA_OUTDIR}/{{org}}/{{genome}}",
        prefix   = "{genome}",
        bakta_db = config.get("cds", {}).get("bakta_db", "")
    threads: 4
    conda:
        f"{config['run'].get('env_dir')}/bakta.yaml"
    shell:
        """
        mkdir -p {params.outdir}

        bakta \
            --db {params.bakta_db} \
            --output {params.outdir} \
            --prefix {params.prefix} \
            --threads {threads} \
            --force \
            {input.genome}
        """




rule interproscan:
    input:
        flag   = f"{RUN_DIR}/gtdbtk/{{org}}/gtdbtk_done.flag",
        faa = f"{BAKTA_OUTDIR}/{{org}}/{{genome}}/{{genome}}.faa",
    output:
        tsv = f"{BAKTA_OUTDIR}/{{org}}/{{genome}}/{{genome}}_domains.tsv"
    params:
        base  = f"{BAKTA_OUTDIR}/{{org}}/{{genome}}/{{genome}}_domains",
        clean = f"{BAKTA_OUTDIR}/{{org}}/{{genome}}/{{genome}}_clean.faa"
    threads: 16
    resources:
        mem_mb = 30000
    shell:
        """
        mkdir -p interpro_temp/{wildcards.genome} logs

        sed '/^>/! s/\*//g' {input.faa} > {params.clean}

        /home/anirudh/interproscan/interproscan.sh \
            -i {params.clean} \
            -f tsv,xml,gff3 \
            -appl Pfam,Gene3D,SUPERFAMILY \
            -dp -goterms -pa \
            -cpu {threads} \
            -T interpro_temp/{wildcards.genome} \
            -b {params.base} \
            > logs/{wildcards.genome}.log 2>&1

        rm -f {params.clean}
        """



rule make_genome_csv:
    """
    NOTE: now reads from the accumulating MASTER_DIR tables (feature 2)
    rather than only this run's per-org outputs, so genomes added in
    earlier runs (or via manual_genomes) stay represented in newly
    generated dataset versions.
    """
    input:
        flag     = f"{RUN_DIR}/gtdbtk/{{org}}/gtdbtk_done.flag",
        checkm2  = f"{MASTER_DIR}/checkm2_quality_report.tsv",
        taxonomy = f"{MASTER_DIR}/gtdbtk_classification.ar53.csv"
    output:
        filtered=f"{config['inputs']['out_genome_csv']}_{{org}}.csv",
        unfiltered=f"{config['inputs']['out_genome_csv_unfiltered']}_{{org}}.csv"
    params:
        completeness=config["checkm2"]["Completeness"],
        contamination=config["checkm2"]["Contamination"]
    run:
        import pandas as pd

        checkm2 = pd.read_csv(input.checkm2, sep="\t")
        taxonomy = pd.read_csv(input.taxonomy)

        df = checkm2.merge(
            taxonomy[
                [
                    "genome_file",
                    "domain",
                    "phylum",
                    "class",
                    "order",
                    "family",
                    "genus",
                    "species",
                ]
            ],
            left_on="Name",
            right_on="genome_file",
            how="left",
        )

        out = pd.DataFrame({
            "Organism Name": "",
            "Organism Infraspecific Names Strain": "",
            "Organism Infraspecific Names Isolate": "",
            "Annotation Name": "",
            "Assembly Level": "",
            "Assembly Release Date": "",
            "WGS project accession": "",
            "Assembly Stats Number of Scaffolds": "",
            "genome_file": df["genome_file"],
            "Completeness": df["Completeness"],
            "Contamination": df["Contamination"],
            "Completeness_Model_Used": df["Completeness_Model_Used"],
            "Translation_Table_Used": df["Translation_Table_Used"],
            "Coding_Density": df["Coding_Density"],
            "Contig_N50": df["Contig_N50"],
            "Average_Gene_Length": df["Average_Gene_Length"],
            "Genome_Size": df["Genome_Size"],
            "GC_Content": df["GC_Content"],
            "Total_Coding_Sequences": df["Total_Coding_Sequences"],
            "Total_Contigs": df["Total_Contigs"],
            "Max_Contig_Length": df["Max_Contig_Length"],
            "batch_date": "",
            "Isolate": "",
            "WGS Project Accession": "",
            "domain": df["domain"],
            "phylum": df["phylum"],
            "class": df["class"],
            "order": df["order"],
            "family": df["family"],
            "genus": df["genus"],
            "species": df["species"],
        })

        # Write unfiltered table
        out.to_csv(output.unfiltered, index=False)

        # Apply CheckM2 thresholds
        filtered = out[
            (out["Completeness"] >= params.completeness)
            & (out["Contamination"] <= params.contamination)
        ]

        filtered.to_csv(output.filtered, index=False)



rule make_protein_csv:
    input:
        genomes = filtered_tsv_for_org,
        fastas = filtered_faa_for_org,
        done_flag = f"{RUN_DIR}/interproscan/{{org}}/ips_done.flag"
    output:
        f"{config['inputs']['out_protein_csv']}_{{org}}.csv"

    run:
        import pandas as pd
        from pathlib import Path
        from Bio import SeqIO

        dfs = []

        for tsv_file, faa_file in zip(input.genomes, input.fastas):

            genome = Path(tsv_file).stem.replace(".tsv", "")

            # ---------------------------------------------------------
            # Parse FASTA once
            # ---------------------------------------------------------
            protein_info = {
                rec.id.split()[0]: {
                    "protein_length": len(rec.seq),
                    "protein_header": rec.description,
                }
                for rec in SeqIO.parse(faa_file, "fasta")
            }

            # ---------------------------------------------------------
            # Read annotation table
            # ---------------------------------------------------------
            with open(tsv_file) as f:
                first = next(f)

            if "Bakta" in first:
                df = pd.read_csv(tsv_file, sep="\t", skiprows=6, header=None)
                df.columns = [
                    "Sequence Id",
                    "Type",
                    "Start",
                    "Stop",
                    "Strand",
                    "Locus Tag",
                    "Gene",
                    "Product",
                    "DbXrefs",
                ]
            else:
                df = pd.read_csv(tsv_file, sep="\t")

            # ---------------------------------------------------------
            # Bakta
            # ---------------------------------------------------------
            if "Locus Tag" in df.columns:

                df = df.rename(columns={
                    "Locus Tag": "locus_tag",
                    "Type": "ftype",
                    "Gene": "gene",
                    "Product": "product",
                })

                df["length_bp"] = (df["Stop"] - df["Start"] + 1).abs()

                df["EC_number"] = ""
                df["COG"] = ""

            # ---------------------------------------------------------
            # Prokka
            # ---------------------------------------------------------
            elif "locus_tag" in df.columns:

                if "length_bp" not in df.columns:
                    df["length_bp"] = (df["end"] - df["start"] + 1).abs()

                if "ftype" not in df.columns:
                    if "type" in df.columns:
                        df["ftype"] = df["type"]
                    else:
                        df["ftype"] = ""

                if "gene" not in df.columns:
                    df["gene"] = ""

                if "product" not in df.columns:
                    df["product"] = ""

                if "EC_number" not in df.columns:
                    df["EC_number"] = ""

                if "COG" not in df.columns:
                    df["COG"] = ""

            else:
                raise ValueError(
                    f"Could not determine annotation format for {tsv_file}\n"
                    f"Columns found: {list(df.columns)}"
                )

            # ---------------------------------------------------------
            # Add protein information from FASTA
            # ---------------------------------------------------------
            df["protein_length"] = df["locus_tag"].map(
                lambda x: protein_info.get(x, {}).get("protein_length")
            )

            df["protein_header"] = df["locus_tag"].map(
                lambda x: protein_info.get(x, {}).get("protein_header")
            )

            out = pd.DataFrame({
                "locus_tag": df["locus_tag"],
                "genome_file": genome,
                "protein_length": df["protein_length"],
                "protein_header": df["protein_header"],
                "ftype": df["ftype"],
                "length_bp": df["length_bp"],
                "gene": df["gene"],
                "EC_number": df["EC_number"],
                "COG": df["COG"],
                "product": df["product"],
                "predicted_structure": "",
                "IPS": "",
                "Manual_annotation": "",
            })

            dfs.append(out)

        pd.concat(dfs, ignore_index=True).to_csv(output[0], index=False)

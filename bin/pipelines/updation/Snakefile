import re
from glob import glob

OUTDIR = config['run']["output_dir"]
ORGS   = [org["name"].replace(" ", "_").lower() for org in config["organisms"]]
STAGES = config["pipeline_stages"]
FINAL_STAGE = STAGES[-1]

wildcard_constraints:
    org        = "|".join(re.escape(o) for o in ORGS),
    genome     = "[^/]+",
    accession  = "[^/]+"

# =========================
# Imports & config
# =========================

import yaml
import os
from pathlib import Path
import pandas as pd
import subprocess

configfile: "config.yaml"

CURRENT_DIR = config["run"].get('base_dir', workflow.basedir)


#
# STORE_DIR  : canonical, deduplicated pool of raw genome FASTAs and bakta
#              annotations. Persists across runs; never duplicated on disk.
# MASTER_DIR : accumulating master tables (checkm2 / gtdbtk) that grow across
#              runs instead of being siloed per run.
# RUN_DIR    : this run's containerized workspace. Everything under it that
#              represents a *genome file* is a symlink into STORE_DIR - the
#              run directory itself holds no duplicated genome bytes.
#
# config.yaml needs a `run: id: <string>` (or top-level `run_id:`), e.g.
#   run:
#     id: 2026-07-23_loki_batch1
#
RUN_ID     = config["run"].get("id", "default")
STORE_DIR  = f"{OUTDIR}/store"
MASTER_DIR = f"{OUTDIR}/master"
RUN_DIR    = f"{OUTDIR}/runs/{RUN_ID}"

#
# config.yaml can optionally declare genomes to inject directly, bypassing
# the NCBI taxon-summary search entirely. Two shapes per entry:
#
#   manual_genomes:
#     lokiarchaeota:
#       - accession: GCF_000001215.4      # fetched singly from NCBI
#       - accession: my_custom_mag_01     # arbitrary ID, used as filename
#         path: /data/manual/my_mag.fna   # local FASTA, copied in as-is
#
MANUAL_GENOMES = config['inputs'].get("manual_genomes", {})

# Genome acquisition and taxonomy are deliberately separate switches.  GTDB
# accessions can be retrieved through gtt while the sequence archive remains
# configurable (NCBI datasets is the portable default downloader).
DOWNLOAD = config.get("download", {})
GENOME_SOURCE = DOWNLOAD.get("source", "ncbi").lower()
UPDATE_MODE = config["run"].get("update", True)
DEDUPE_ENABLED = config.get("deduplication", {}).get("enabled", False)
GTDB = config.get("gtdb", {})
# Preserve the historical behaviour for configurations that only provide the
# GTDB-Tk database path.  Metadata mode is an explicit opt-in.
RUN_GTDBTK = GTDB.get("run_gtdbtk", True)
GTDB_METADATA = GTDB.get("metadata_file", f"{STORE_DIR}/metadata/gtdb_ar53_metadata.tsv")
GTDB_METADATA_URL = GTDB.get("metadata_url", "")

if GENOME_SOURCE not in {"ncbi", "gtt"}:
    raise ValueError("download.source must be either 'ncbi' or 'gtt'")


def manual_accessions(org):
    return [g["accession"] for g in MANUAL_GENOMES.get(org, [])]


def normalize_accession(value):
    """Return the accession represented by a GTDB or FASTA file identifier."""
    accession = Path(str(value)).name
    while accession.endswith(".fna"):
        accession = accession[:-4]
    return re.sub(r"^(RS_|GB_)", "", accession)


def _manual_genome_info(accession):
    for org, entries in MANUAL_GENOMES.items():
        for g in entries:
            if g["accession"] == accession:
                return g
    raise KeyError(f"No manual_genomes entry found for accession '{accession}'")


ALL_MANUAL_ACCESSIONS = [
    g["accession"] for entries in MANUAL_GENOMES.values() for g in entries
]


# =========================
# Helper functions
# (must be defined before any code that calls them)
# =========================

def stage_dir(org, stage):
    stage_map = {
        "raw":      f"{RUN_DIR}/{org}/genomes",
        "filtered": f"{RUN_DIR}/{org}/filtered",
        "derep":    f"{RUN_DIR}/skder/{org}",
    }
    return stage_map[stage]


def prev_stage_dir(org, stage):
    idx = STAGES.index(stage)
    if idx == 0:
        raise ValueError(f"Stage '{stage}' has no previous stage")
    return stage_dir(org, STAGES[idx - 1])


def get_org_param(wc, field, default=None):
    org = next(
        o for o in config["organisms"]
        if o["name"].replace(" ", "_").lower() == wc.org
    )
    return org.get(field, default)


# =========================
# Bakta configuration
# =========================
#
# NOTE: bakta/interproscan annotations are canonical too - they're expensive
# and reusable across runs, so (like raw genomes) they live under STORE_DIR
# unless the user points at an existing external annotation directory.

BAKTA_EXISTING = config.get("cds", {}).get("existing")

if BAKTA_EXISTING:
    BAKTA_OUTDIR     = Path(BAKTA_EXISTING)
    EXISTING_GENOMES = {p.name for p in BAKTA_OUTDIR.iterdir() if p.is_dir()}
else:
    BAKTA_OUTDIR     = Path(f"{STORE_DIR}/bakta")
    EXISTING_GENOMES = set()


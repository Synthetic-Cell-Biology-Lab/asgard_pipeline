rule all:
    input:
        expand(f"{RUN_DIR}/{{org}}/done.flag",                      org=ORGS),
        expand(f"{RUN_DIR}/skder/{{org}}/dedup_done.flag",          org=ORGS),
        expand(f"{RUN_DIR}/checkm2/{{org}}/checkm2_done.flag",      org=ORGS),
        expand(f"{RUN_DIR}/gtdbtk/{{org}}/gtdbtk_done.flag",        org=ORGS),
        expand(f"{RUN_DIR}/gtdbtk/{{org}}_taxa_count.svg",          org=ORGS),
        expand(f"{RUN_DIR}/interproscan/{{org}}/ips_done.flag",     org=ORGS),
        expand(f"{config['inputs']['out_fasta']}_{{org}}.faa" ,org = ORGS),
        expand(f"{config['inputs']['out_genome_csv']}_{{org}}.csv", org = ORGS),
        expand(f"{config['inputs']['out_protein_csv']}_{{org}}.csv", org = ORGS),
        # NEW: master tables + manually-added genomes are always in scope
        f"{MASTER_DIR}/checkm2_quality_report.tsv",
        f"{MASTER_DIR}/gtdbtk_classification.ar53.csv",
        expand(f"{STORE_DIR}/genomes/{{accession}}.fna", accession=ALL_MANUAL_ACCESSIONS),
        expand(f"{config['inputs']['out_ips_parquet']}_{{org}}.parquet", org = ORGS),
        expand(f"{config['inputs']['out_ips_parquet']}_{{org}}_summary.parquet", org = ORGS)




# get the list of genomes that is already present in our database
rule check_database:
    params:
        input_path = f"{BAKTA_OUTDIR}/{{org}}/"
    output:
        genomes_present = f"{RUN_DIR}/{{org}}/present_list.txt"
    conda:
        f"{config['run'].get('env_dir')}/Reg.yaml"
    shell:
        """
        mkdir -p {params.input_path}
        touch {output}
        find {params.input_path} -maxdepth 1 -mindepth 1 -type d -printf '%f\n' > {output}

        """

# get the summary of genomse deposited in the ncbi-datasets with our specifications
rule get_summary:
    """
    The input taken (in params) is the organism name that is matching to ncbi-dataset
    in the config file

    Gives output of a summary file matching the constraints provided from ncbi-datasets  
    Search yields serveral reports per genome, needs to be deduplicated.
    """
    output:
        summary=f"{RUN_DIR}/{{org}}/genomes_summary.tsv"
    conda:
        f"{config['run'].get('env_dir')}/Reg.yaml"
    params:
        name=lambda wc: get_org_param(wc, "name"),
        level=lambda wc: " ".join(f"--assembly-level {l}" for l in (get_org_param(wc, "assembly_level") or [])),
        refseq=lambda wc: "--reference" if get_org_param(wc, "refseq_only") else "",
        gtt_taxon=lambda wc: get_org_param(wc, "gtt_taxon", DOWNLOAD.get("gtt_taxon", "asgardarchaeota")),
        gtt_command=DOWNLOAD.get("gtt_command", "gtt-get-accessions")
    run:
        os.makedirs(os.path.dirname(output.summary), exist_ok=True)
        if GENOME_SOURCE == "gtt":
            # gtt returns one accession per line.  Normalize its output to the
            # NCBI-summary column consumed by the remainder of this workflow.
            result = subprocess.run(
                [params.gtt_command, "-t", params.gtt_taxon],
                check=True, text=True, capture_output=True,
            )
            accessions = sorted({
                line.split()[0] for line in result.stdout.splitlines()
                if line.strip() and not line.lower().startswith("accession")
            })
            pd.DataFrame({"Assembly Accession": accessions}).to_csv(output.summary, sep="\t", index=False)
        else:
            shell(
                r'''TAXID=$(datasets summary taxonomy taxon "{params.name}" --as-json-lines | dataformat tsv taxonomy --template tax-summary | awk 'NR==2 {{print $2}}')
                datasets summary genome taxon "$TAXID" {params.level} {params.refseq} --as-json-lines | dataformat tsv genome > {output.summary}'''
            )




rule prepare_download_list:
    """
    Takes the summary file, subtracts genomes already present (annotated in a
    prior run), genomes already sitting in the canonical STORE_DIR pool
    (downloaded by this or any earlier run), and genomes that are being
    supplied manually for this org (see `manual_genomes` in config, handled
    by `add_manual_genome` / `link_run_genomes`). What's left is the true
    delta that actually needs to be fetched from NCBI this run.
    """
    input:
        summary=f"{RUN_DIR}/{{org}}/genomes_summary.tsv",
        genomes_present = f"{RUN_DIR}/{{org}}/present_list.txt"
    output:
        accession_list = f"{RUN_DIR}/{{org}}/accession_list_to_download.txt"
    conda:
        f"{config['run'].get('env_dir')}/Reg.yaml"
    run:
        import pandas as pd
        from pathlib import Path

        summary_df = pd.read_csv(input.summary, sep="\t")
        with open(input.genomes_present) as f:
            present_list = [
                "_".join(line.strip().split("_")[:2])
                for line in f
                if line.strip()
            ]

        # In fresh mode only genomes selected for this run are considered.
        # Update mode reuses the canonical store and annotation inventory.
        store_dir = Path(STORE_DIR, "genomes")
        store_dir.mkdir(parents=True, exist_ok=True)
        store_have = {p.stem for p in store_dir.glob("*.fna")}

        # manual additions are injected separately, never auto-downloaded
        manual = set(manual_accessions(wildcards.org))

        selected = set(summary_df['Assembly Accession'].dropna().astype(str).tolist()) - manual
        to_be_downloaded = selected - manual
        if UPDATE_MODE:
            to_be_downloaded -= set(present_list) | store_have

        with open(output.accession_list, 'w') as out:
            out.write("\n".join(sorted(to_be_downloaded)))
        




rule download_genomes:
    # Downloads genomes from ncbi datasets. The list is often empty on
    # repeat runs now that genomes are deduplicated against STORE_DIR, so
    # this guards against calling `datasets download` with nothing to fetch.
    input:
        accession_list = f"{RUN_DIR}/{{org}}/accession_list_to_download.txt"
    output:
        zipfile = f"{RUN_DIR}/{{org}}/dataset.zip"
    conda:
        f"{config['run'].get('env_dir')}/Reg.yaml"
    shell:
        """
        if [ -s {input.accession_list} ]; then
            datasets download genome accession \
                --inputfile {input.accession_list} \
                --include genome \
                --filename {output.zipfile} \
                --dehydrated
        else
            mkdir -p $(dirname {output.zipfile})
            : > {output.zipfile}
        fi
        """


rule extract_genomes:
    """
    Rehydrates any newly downloaded genomes and imports them into the
    canonical, deduplicated STORE_DIR pool (STORE_DIR/genomes/<accession>.fna).
    This rule deliberately does NOT write into the run-specific directory -
    that containerized view is assembled purely from symlinks by
    `link_run_genomes` below, so genome bytes are never duplicated per run.
    """
    input:
        zipfile = f"{RUN_DIR}/{{org}}/dataset.zip"
    output:
        flag = f"{RUN_DIR}/{{org}}/download_done.flag"
    conda:
        f"{config['run'].get('env_dir')}/Reg.yaml"
    shell:
        """
        mkdir -p {STORE_DIR}/genomes
        EXTRACT_DIR={RUN_DIR}/{wildcards.org}/extracted

        if [ -s {input.zipfile} ]; then
            mkdir -p $EXTRACT_DIR
            unzip -o {input.zipfile} -d $EXTRACT_DIR

            datasets rehydrate --directory $EXTRACT_DIR

            find $EXTRACT_DIR/ncbi_dataset/data/ -name "*.fna" | while read -r f; do
                acc=$(basename "$f" .fna)
                if [ ! -f {STORE_DIR}/genomes/"$acc".fna ]; then
                    cp "$f" {STORE_DIR}/genomes/"$acc".fna
                fi
            done
        fi

        touch {output.flag}
        """


rule link_run_genomes:
    """
    Assembles this run's containerized genome directory using only symlinks
    into STORE_DIR. This is the single place where automatically-downloaded
    genomes (from `extract_genomes`) and manually-added genomes (feature 3,
    from `add_manual_genome`) converge into one view for this run - without
    duplicating any underlying .fna bytes on disk.

    Produces the same `done.flag` / `genomes` outputs that downstream rules
    (checkm2, link_filtered, skder, gtdbtk, ...) already expect, so nothing
    further down the DAG needs to change.
    """
    input:
        download_flag  = f"{RUN_DIR}/{{org}}/download_done.flag",
        summary        = f"{RUN_DIR}/{{org}}/genomes_summary.tsv",
        manual_genomes = lambda wc: expand(
            f"{STORE_DIR}/genomes/{{accession}}.fna",
            accession=manual_accessions(wc.org)
        )
    output:
        flag    = f"{RUN_DIR}/{{org}}/done.flag",
        genomes = directory(f"{RUN_DIR}/{{org}}/genomes"),
        # Records the per-organism membership of the canonical genome store.
        # This prevents cumulative runs from mixing organisms.
        manifest = f"{STORE_DIR}/organisms/{{org}}.accessions.txt"
    conda:
        f"{config['run'].get('env_dir')}/Reg.yaml"
    run:
        import pandas as pd
        import os

        os.makedirs(output.genomes, exist_ok=True)
        manifest = Path(output.manifest)

        summary_df = pd.read_csv(input.summary, sep="\t")
        print(summary_df.columns)
        print(summary_df.head())
        print(len(summary_df))
        accessions = set(
            str(x).strip()
            for x in summary_df["Assembly Accession"]
            if pd.notna(x)
        )
        accessions.update(manual_accessions(wildcards.org))
        if UPDATE_MODE and manifest.exists():
            # Accumulate only genomes previously associated with this
            # organism, never the complete global store.
            accessions.update(
                line.strip() for line in manifest.read_text().splitlines()
                if line.strip()
            )

        # Rebuild the run view so fresh runs cannot retain stale symlinks from
        # an earlier run with the same id.
        for genome in Path(output.genomes).iterdir():
            if genome.is_symlink() or genome.is_file():
                genome.unlink()

        for acc in accessions:
            matches = glob(f"{STORE_DIR}/genomes/{acc}.fna")
            if matches:
                src = os.path.abspath(matches[0])
                dst = f"{output.genomes}/{os.path.basename(src)}"
            # silently skipped if the .fna never made it into the store
            # (e.g. a "present"/already-annotated genome from before the
            # store existed) - same net effect as the old behaviour.
                if os.path.exists(src) and not os.path.exists(dst):
                    os.symlink(src, dst)

        manifest.parent.mkdir(parents=True, exist_ok=True)
        manifest.write_text("\n".join(sorted(accessions)) + "\n")

        with open(output.flag, "w") as f:
            f.write("done\n")


# ---- NEW: single genome addition (feature 3) -------------------------------

rule add_manual_genome:
    """
    Registers a manually supplied genome into the canonical STORE_DIR pool,
    exactly like an automatically-downloaded genome. Two modes, chosen by
    whether the manual_genomes config entry provides a `path`:

      - `path` given  -> copied in verbatim (a local FASTA / custom MAG)
      - no `path`     -> fetched singly from NCBI by accession

    Once in the store, `link_run_genomes` symlinks it into any org's run
    directory that lists it under `manual_genomes`, and it flows through
    checkm2 / dereplication / gtdbtk / bakta like any other genome.
    """
    output:
        genome = f"{STORE_DIR}/genomes/{{accession}}.fna"
    params:
        path = lambda wc: _manual_genome_info(wc.accession).get("path", "")
    conda:
        f"{config['run'].get('env_dir')}/Reg.yaml"
    shell:
        """
        mkdir -p {STORE_DIR}/genomes

        if [ -n "{params.path}" ]; then
            cp "{params.path}" {output.genome}
        else
            TMPDIR=$(mktemp -d)
            datasets download genome accession {wildcards.accession} \
                --include genome \
                --filename $TMPDIR/dl.zip
            unzip -o $TMPDIR/dl.zip -d $TMPDIR/extracted
            find $TMPDIR/extracted/ncbi_dataset/data/ -name "*.fna" \
                -exec cp {{}} {output.genome} \;
            rm -rf $TMPDIR
        fi
        """


rule checkm2:
    """
    Given that we are working with MAGs, we need to perform quality control to 
    ensure that the results that get is valid and not from contamination
    """
    input:
        flag        = f"{RUN_DIR}/{{org}}/done.flag",
        genomes_dir = f"{RUN_DIR}/{{org}}/genomes"
    output:
        checkm2_flag   = f"{RUN_DIR}/checkm2/{{org}}/checkm2_done.flag",
        quality_report = f"{RUN_DIR}/checkm2/{{org}}/quality_report.tsv"
    threads: 16
    params:
        db = config["checkm2"]["db_path"],
        outdir         =f"{RUN_DIR}/checkm2/{{org}}",

    conda:
        f"{config['run'].get('env_dir')}/checkm2.yaml"
    shell:
        """
        checkm2 predict \
            --input {input.genomes_dir} \
            --output-directory {params.outdir} \
            --database_path {params.db} \
            --extension fna \
            --threads {threads} \
            --force

        touch {output.checkm2_flag}
        """


rule link_filtered:
    # create symlink for files that pass checkm2 parameter thresholds
    input:
        quality_report = f"{RUN_DIR}/checkm2/{{org}}/quality_report.tsv",
        genomes_dir    = lambda wc: stage_dir(wc.org, "raw")   # FIX: was prev_stage_dir(wc.org, "filtered")
    output:
        filtered_dir  = directory(f"{RUN_DIR}/{{org}}/filtered"),
        filtered_list = f"{RUN_DIR}/{{org}}/filtered/passed_genomes.txt"
    threads: 1
    params:
        cont         = config["checkm2"]["Contamination"],
        completeness = config["checkm2"]["Completeness"]
    conda:
        f"{config['run'].get('env_dir')}/Reg.yaml"
    shell:
        """
        mkdir -p {output.filtered_dir}

        awk -F' ' \
            -v completeness={params.completeness} \
            -v cont={params.cont} \
            'NR > 1 && $2 >= completeness && $3 <= cont {{ print $1 }}' \
            {input.quality_report} \
        > {output.filtered_list}

        while read genome; do
            ln -s {input.genomes_dir}/${{genome}}.fna {output.filtered_dir}/
        done < {output.filtered_list}
        """


rule skder:
    # Deduplication of genomes to avoid over-representation of any genome
    input:
        genomes_dir = lambda wc: prev_stage_dir(wc.org, "derep"),
        stage_list  = lambda wc: f"{prev_stage_dir(wc.org, 'derep')}/passed_genomes.txt"
    output:
        derep_dir  = directory(f"{RUN_DIR}/skder/{{org}}"),
        derep_list = f"{RUN_DIR}/skder/{{org}}/derep_genomes.txt",
        flag       = f"{RUN_DIR}/skder/{{org}}/dedup_done.flag",
    threads: 16
    params:
        ani    = config['deduplication']['ani'],
        min_af = config['deduplication']['min_af']
    conda:
        f"{config['run'].get('env_dir')}/skder.yaml" if DEDUPE_ENABLED else f"{config['run'].get('env_dir')}/Reg.yaml"
    run:
        representatives = Path(output.derep_dir, "Dereplicated_Representative_Genomes")
        representatives.mkdir(parents=True, exist_ok=True)
        if DEDUPE_ENABLED:
            shell("skder -g {input.genomes_dir} -o {output.derep_dir} -i {params.ani} -f {params.min_af} -c {threads}")
        else:
            # Preserve the downstream interface without running skder: every
            # CheckM2-passing genome is a representative.
            for genome in Path(input.genomes_dir).glob("*.fna"):
                target = representatives / genome.name
                if not target.exists():
                    target.symlink_to(genome.resolve())
        Path(output.derep_list).write_text(
            "\n".join(sorted(normalize_accession(p) for p in representatives.glob("*.fna"))) + "\n"
        )
        Path(output.flag).touch()


rule gtdbtk:
    # taxonomic classification of genomes
    input:
        genomes_dir = lambda wc: f"{stage_dir(wc.org, STAGES[-1])}",
        derep_list  = lambda wc: f"{stage_dir(wc.org, STAGES[-1])}/derep_genomes.txt",
        db_dir      = ancient(GTDB["db_path"]) if RUN_GTDBTK else [],
        metadata    = GTDB_METADATA if not RUN_GTDBTK else []
    output:
        outdir = directory(f"{RUN_DIR}/gtdbtk/{{org}}"),
        flag   = f"{RUN_DIR}/gtdbtk/{{org}}/gtdbtk_done.flag"
    threads:
        config["gtdb"].get("threads", 16)
    params:
        db           = GTDB.get("db_path", ""),
        extension    = config["gtdb"].get("extension",    "fna"),
        prefix       = config["gtdb"].get("prefix",       "gtdbtk"),
        min_perc_aa  = config["gtdb"].get("min_perc_aa",  10),
        min_af       = config["gtdb"].get("min_af",       0.65),
        pplacer_cpus = config["gtdb"].get("pplacer_cpus", 4),
        scratch_dir  = config["gtdb"].get("scratch_dir",  "/tmp"),
        extra_args   = config["gtdb"].get("extra_args",   "")
    conda:
        f"{config['run'].get('env_dir')}/gtdbtk.yaml" if RUN_GTDBTK else f"{config['run'].get('env_dir')}/Reg.yaml"
    run:
        os.makedirs(output.outdir, exist_ok=True)
        if RUN_GTDBTK:
            shell("export GTDBTK_DATA_PATH={params.db}; gtdbtk classify_wf --genome_dir {input.genomes_dir}/Dereplicated_Representative_Genomes --out_dir {output.outdir} --extension {params.extension} --prefix {params.prefix} --min_perc_aa {params.min_perc_aa} --min_af {params.min_af} --cpus {threads} --pplacer_cpus {params.pplacer_cpus} --scratch_dir {params.scratch_dir} {params.extra_args}")
        else:
            metadata = pd.read_csv(input.metadata, sep="\t", dtype=str)
            genome_column = next((c for c in ("accession", "genome", "user_genome") if c in metadata.columns), None)
            classification_column = next((c for c in ("gtdb_taxonomy", "classification") if c in metadata.columns), None)
            if not genome_column or not classification_column:
                raise ValueError("GTDB metadata must contain accession/genome and gtdb_taxonomy/classification columns")
            selected = {
                normalize_accession(p)
                for p in Path(input.genomes_dir, "Dereplicated_Representative_Genomes").glob("*.fna")
            }
            metadata[genome_column] = metadata[genome_column].map(normalize_accession)
            result = metadata[metadata[genome_column].isin(selected)][[genome_column, classification_column]].rename(columns={genome_column: "user_genome", classification_column: "classification"})
            missing = selected - set(result["user_genome"])
            if missing:
                raise ValueError(f"GTDB metadata has no taxonomy for: {', '.join(sorted(missing))}")
            result.to_csv(f"{output.outdir}/{params.prefix}.ar53.summary.tsv", sep="\t", index=False)
        Path(output.flag).touch()


rule retrieve_gtdb_metadata:
    """Cache the GTDB archaeal metadata used by verified-taxonomy mode."""
    output:
        metadata = GTDB_METADATA
    params:
        url = GTDB_METADATA_URL
    conda:
        f"{config['run'].get('env_dir')}/Reg.yaml"
    shell:
        """
        if [ -z "{params.url}" ]; then
            echo "gtdb.metadata_url is required to retrieve missing GTDB metadata" >&2
            exit 2
        fi

        mkdir -p $(dirname {output.metadata})
        TMP_METADATA=$(mktemp "$(dirname {output.metadata})/.gtdb-metadata.XXXXXX")
        case "{params.url}" in
            *.gz) curl --fail --location --silent --show-error "{params.url}" | gzip -dc > "$TMP_METADATA" ;;
            *)    curl --fail --location --silent --show-error "{params.url}" > "$TMP_METADATA" ;;
        esac
        mv "$TMP_METADATA" {output.metadata}
        """




checkpoint split_taxonomy:
    # split the taxonomic levels into individual columns from the gtdbtk output
    # also a checkpoint to revise the processes required to be run
    input:
        flag   = f"{RUN_DIR}/gtdbtk/{{org}}/gtdbtk_done.flag"

    output:
        f"{RUN_DIR}/gtdbtk/{{org}}_gtdbtk_classification_split.ar53.csv"
    conda:
        f"{config['run'].get('env_dir')}/Reg.yaml"
    params:
        tsv_file = f"{RUN_DIR}/gtdbtk/{{org}}/gtdbtk.ar53.summary.tsv"
    run:
        import pandas as pd

        df = pd.read_csv(params.tsv_file, sep="\t")

        ranks = ["domain", "phylum", "class",
                 "order", "family", "genus", "species"]

        tax_split = (
            df["classification"]
            .str.split(";", expand=True)
            .iloc[:, :7]
        )
        tax_split.columns = ranks

        for col in ranks:
            tax_split[col] = tax_split[col].str.replace(
                r"^[dpcofgs]__", "", regex=True
            )

        df = pd.concat([df, tax_split], axis=1)
        df['genome_file'] = df['user_genome']
        df.to_csv(output[0], index=False)


